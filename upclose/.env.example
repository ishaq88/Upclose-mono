# Local development placeholders only. Compose has fixture defaults and needs no .env.
# Compose always uses its private internal hostname; browser signs against localhost.
DATABASE_URL=postgresql+psycopg://upclose:local-development-only@localhost:55432/upclose
APP_BASE_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
# Extra browser origins (comma-separated http(s) origins, no path) allowed by API
# and bucket CORS in addition to WEB_ORIGIN, e.g. for LAN/phone testing:
# WEB_EXTRA_ORIGINS=http://192.168.1.16:5173
WEB_EXTRA_ORIGINS=
# Host bind addresses for the web (5173) and storage (4566) ports. Default is
# loopback only; set to 0.0.0.0 (with WEB_EXTRA_ORIGINS and a LAN
# S3_PUBLIC_ENDPOINT, e.g. http://192.168.1.16:4566) only for LAN testing.
WEB_BIND=127.0.0.1
STORAGE_BIND=127.0.0.1
S3_BUCKET=upclose-local
S3_INTERNAL_ENDPOINT=http://localhost:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=local-development-only
AWS_SECRET_ACCESS_KEY=local-development-only
AWS_DEFAULT_REGION=us-east-1
MODEL_MODE=fixture
# Owner session creation; proxy networks are an explicit JSON array, empty by default.
CONSENT_VERSION=upclose-prototype-v1
SESSION_CREATION_LIMIT_PER_DAY=3
TRUSTED_PROXY_HOSTS=[]
# Worker-only live/demo settings; fixture mode does not use paid credentials.
# Never pass MODEL_API_KEY to the api container; use infra/compose.live-demo.yaml (worker only).
# Caps are cents and tunable without code change; demo defaults are 500 ($5) / 5000 ($50).
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai
MODEL_PRICE_VERSION=meta-docs-2026-10-28
MODEL_SESSION_BUDGET_CENTS=500
MODEL_DAILY_BUDGET_CENTS=5000
MODEL_STANDARD_ACCESS_RECEIPT=
MODEL_ALLOW_NON_STANDARD_DEMO=false
# Billing: fixture (default, in-process fake Stripe) or test (requires sk_test_/rk_test_ key). Live keys are refused.
# Base Compose stays fixture; opt in with infra/compose.stripe-test.yaml. See .docs/evidence/stripe-test-runbook.md.
PAYMENTS_MODE=fixture
# Dev-demo only: true (fixture payments only) makes Unlock grant a labeled demo entitlement with no charge.
DEMO_FREE_UNLOCK=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_REPORT_PRICE_ID=
# Empty disables operator cost-status and derivative-review endpoints. Use a separate random credential locally.
OPERATOR_TOKEN=
DEMO_SESSION_ID=
PUBLIC_SHARING_ENABLED=false
# Browser variables must never contain service credentials.
# Vite development server proxy target, server-only:
API_PROXY_TARGET=http://localhost:8000
